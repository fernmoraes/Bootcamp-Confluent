{
  "type": "record",
  "name": "TransactionEvent",
  "namespace": "com.bootcamp.payments.evolution",
  "doc": "Schema v1 base para teste de compatibilidade",
  "fields": [
    {
      "name": "transaction_id",
      "type": "long"
    },
    {
      "name": "card_id",
      "type": "int"
    },
    {
      "name": "amount",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 15,
        "scale": 2
      }
    },
    {
      "name": "currency",
      "type": "string"
    },
    {
      "name": "status",
      "type": "string"
    },
    {
      "name": "txn_ts",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    }
  ]
}
