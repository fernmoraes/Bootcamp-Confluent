{
  "type": "record",
  "name": "TransactionEvent",
  "namespace": "com.bootcamp.payments.evolution",
  "doc": "Schema v2 INCOMPATÍVEL BACKWARD (remove campo obrigatório 'amount' sem default)",
  "fields": [
    {
      "name": "transaction_id",
      "type": "long"
    },
    {
      "name": "card_id",
      "type": "int"
    },
    {
      "name": "currency",
      "type": "string"
    },
    {
      "name": "status",
      "type": "string"
    },
    {
      "name": "txn_ts",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    }
  ]
}
