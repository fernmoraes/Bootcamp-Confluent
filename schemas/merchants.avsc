{
  "type": "record",
  "name": "Merchant",
  "namespace": "com.bootcamp.payments.merchant",
  "doc": "Registro canônico de estabelecimentos comerciais recebedores",
  "fields": [
    {
      "name": "merchant_id",
      "type": "int",
      "doc": "Identificador único do estabelecimento comercial (PK)"
    },
    {
      "name": "name",
      "type": "string",
      "doc": "Nome fantasia do estabelecimento"
    },
    {
      "name": "mcc",
      "type": "string",
      "doc": "Merchant Category Code com 4 dígitos (ex: 5411, 5812)"
    },
    {
      "name": "category",
      "type": "string",
      "doc": "Nome da categoria do estabelecimento (ex: Supermercado, Restaurante)"
    },
    {
      "name": "city",
      "type": "string",
      "doc": "Cidade do estabelecimento"
    },
    {
      "name": "country",
      "type": "string",
      "default": "BR",
      "doc": "Código ISO do país de operação"
    }
  ]
}
