# Copie para .env e preencha. NUNCA versione o .env.

# --- Confluent Cloud (conta pessoal, usada só em setup/teardown) ---
CONFLUENT_CLOUD_EMAIL=
CONFLUENT_CLOUD_PASSWORD=

# --- Convenções de nomes (prefixo obrigatório: desafio-) ---
RESOURCE_PREFIX=desafio-
ENV_NAME=desafio-final
CLUSTER_NAME=desafio-basic
CLUSTER_CLOUD=aws
CLUSTER_REGION=us-east-1
PRODUCER_SA_NAME=desafio-producer
CONSUMER_SA_NAME=desafio-consumer
CONSUMER_GROUP_PREFIX=desafio-
TOPIC_PREFIX=desafio
FLINK_COMPUTE_POOL_NAME=desafio-pool
CONNECTOR_NAME=desafio-cdc

# --- Neon (Postgres de origem) ---
PG_HOST=
PG_PORT=5432
PG_DATABASE=
# Usuário administrador (usado só para criar schema, seed e cdc_user)
PG_ADMIN_USER=
PG_ADMIN_PASSWORD=
# Usuário de menor privilégio usado pelo conector (criado em db/)
CDC_USER=cdc_user
CDC_PASSWORD=
PG_SSLMODE=require

# --- Seed determinístico ---
SEED=42
